{
  "entities": {
    "StudioProfile": {
      "title": "StudioProfile",
      "description": "Public studio profile and real-time moderation state for an authenticated participant or model (zero PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["model", "moderator", "viewer"]
        },
        "accessStatus": {
          "type": "string",
          "enum": ["active", "vip", "muted", "blocked"]
        },
        "isOnline": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "accessStatus", "isOnline", "createdAt", "updatedAt"]
    },
    "PrivateUserInfo": {
      "title": "PrivateUserInfo",
      "description": "Isolated PII document storing user email strictly restricted to owner and admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "StudioState": {
      "title": "StudioState",
      "description": "Live status and active video call metadata for the model's studio room.",
      "type": "object",
      "properties": {
        "modelUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "modelName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "isLive": {
          "type": "boolean"
        },
        "callMode": {
          "type": "string",
          "enum": ["open", "queue_only", "paused"]
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "activeCallId": {
          "type": "string",
          "maxLength": 128
        },
        "activeCallUserId": {
          "type": "string",
          "maxLength": 128
        },
        "activeCallUserName": {
          "type": "string",
          "maxLength": 80
        },
        "autoScheduleEnabled": {
          "type": "boolean"
        },
        "scheduleStartTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "scheduleEndTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "scheduleDays": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^([0-6](,[0-6])*)?$"
        },
        "scheduleTimezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "dndActive": {
          "type": "boolean"
        },
        "dndUntilMs": {
          "type": "integer"
        },
        "dndScheduleEnabled": {
          "type": "boolean"
        },
        "dndStartTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "dndEndTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["modelUid", "modelName", "isLive", "callMode", "headline", "updatedAt"]
    },
    "CallRequest": {
      "title": "CallRequest",
      "description": "Video call request and session lifecycle record between a user and the studio model.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "userPhotoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "accepted", "in_call", "ended", "rejected", "cancelled"]
        },
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "planDurationMinutes": {
          "type": "integer"
        },
        "planPriceCents": {
          "type": "integer"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["authorized", "captured", "refunded"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "userName", "topic", "status", "createdAt", "updatedAt"]
    },
    "CallMessage": {
      "title": "CallMessage",
      "description": "Real-time text message exchanged inside an active video call session.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "senderRole": {
          "type": "string",
          "enum": ["model", "moderator", "viewer"]
        },
        "recipientUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "callId", "senderUid", "senderName", "senderRole", "recipientUid", "text", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Verified studio admin/model privilege marker document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt"]
    },
    "CallHistoryRecord": {
      "title": "CallHistoryRecord",
      "description": "Finalized video call history entry with duration, timestamp, and transaction amount in BRL cents.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "modelUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "durationSeconds": {
          "type": "integer"
        },
        "amountCents": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "enum": ["BRL"]
        },
        "status": {
          "type": "string",
          "enum": ["completed", "refunded"]
        },
        "planId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planName": {
          "type": "string",
          "maxLength": 60
        },
        "planDurationMinutes": {
          "type": "integer"
        },
        "rating": {
          "type": "integer",
          "description": "Participant video call quality score from 1 to 5 stars."
        },
        "ratingComment": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional participant comment on video and audio quality."
        },
        "ratedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the participant submitted the call rating."
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "callId", "userId", "userName", "modelUid", "durationSeconds", "amountCents", "currency", "status", "endedAt", "createdAt"]
    },
    "InterestMessage": {
      "title": "InterestMessage",
      "description": "Message left by a visitor while the model is offline or resting, expressing interest for when she returns.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "userPhotoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "preferredTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["unread", "reviewed", "contacted"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "userName", "preferredTime", "message", "status", "createdAt", "updatedAt"]
    },
    "CallPlan": {
      "title": "CallPlan",
      "description": "Predefined paid video call plan configured by the model admin for charging all visitor calls.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "durationMinutes": {
          "type": "integer"
        },
        "priceCents": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "enum": ["BRL"]
        },
        "active": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "description", "durationMinutes", "priceCents", "currency", "active", "sortOrder", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/studioProfiles/{userId}": {
      "schema": { "$ref": "#/entities/StudioProfile" },
      "description": "Studio member profiles and live access control status."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/PrivateUserInfo" },
      "description": "PII-isolated account metadata restricted to owner and studio admin."
    },
    "/studioState/{stateId}": {
      "schema": { "$ref": "#/entities/StudioState" },
      "description": "Live studio availability and active video call banner."
    },
    "/callQueue/{requestId}": {
      "schema": { "$ref": "#/entities/CallRequest" },
      "description": "Real-time queue of user video call requests to the model."
    },
    "/callMessages/{messageId}": {
      "schema": { "$ref": "#/entities/CallMessage" },
      "description": "Messages scoped to an active call session."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Trusted admin UID registry."
    },
    "/callHistory/{recordId}": {
      "schema": { "$ref": "#/entities/CallHistoryRecord" },
      "description": "Completed call history records with duration, date, and finalized BRL transaction amount."
    },
    "/interestMessages/{messageId}": {
      "schema": { "$ref": "#/entities/InterestMessage" },
      "description": "Interest messages left by visitors when the model is offline or resting."
    },
    "/callPlans/{planId}": {
      "schema": { "$ref": "#/entities/CallPlan" },
      "description": "Predefined paid video call plans managed by the model admin."
    }
  }
}
