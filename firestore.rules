rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Token-only admin check safe for list rules (no get/exists calls)
    function isTokenAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'automation.ioan@gmail.com';
    }

    // Full admin check for single-doc reads and writes
    function isAdmin() {
      return isTokenAdmin() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Validation Blueprints ---
    function isValidStudioProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'accessStatus', 'isOnline', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'role', 'accessStatus', 'isOnline', 'notes', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.role in ['model', 'moderator', 'viewer'] &&
        data.accessStatus in ['active', 'vip', 'muted', 'blocked'] &&
        data.isOnline is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
    }

    function isValidPrivateUserInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudioState(data) {
      return data.keys().hasAll(['modelUid', 'modelName', 'isLive', 'callMode', 'headline', 'updatedAt']) &&
        data.keys().hasOnly(['modelUid', 'modelName', 'isLive', 'callMode', 'headline', 'activeCallId', 'activeCallUserId', 'activeCallUserName', 'autoScheduleEnabled', 'scheduleStartTime', 'scheduleEndTime', 'scheduleDays', 'scheduleTimezone', 'dndActive', 'dndUntilMs', 'dndScheduleEnabled', 'dndStartTime', 'dndEndTime', 'updatedAt']) &&
        isValidId(data.modelUid) &&
        data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 80 &&
        data.isLive is bool &&
        data.callMode in ['open', 'queue_only', 'paused'] &&
        data.headline is string && data.headline.size() >= 1 && data.headline.size() <= 140 &&
        data.updatedAt is timestamp &&
        (!('activeCallId' in data) || (data.activeCallId is string && data.activeCallId.size() <= 128)) &&
        (!('activeCallUserId' in data) || (data.activeCallUserId is string && data.activeCallUserId.size() <= 128)) &&
        (!('activeCallUserName' in data) || (data.activeCallUserName is string && data.activeCallUserName.size() <= 80)) &&
        (!('autoScheduleEnabled' in data) || data.autoScheduleEnabled is bool) &&
        (!('scheduleStartTime' in data) || (data.scheduleStartTime is string && data.scheduleStartTime.size() == 5 && data.scheduleStartTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
        (!('scheduleEndTime' in data) || (data.scheduleEndTime is string && data.scheduleEndTime.size() == 5 && data.scheduleEndTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
        (!('scheduleDays' in data) || (data.scheduleDays is string && data.scheduleDays.size() <= 20 && data.scheduleDays.matches('^([0-6](,[0-6])*)?$'))) &&
        (!('scheduleTimezone' in data) || (data.scheduleTimezone is string && data.scheduleTimezone.size() >= 1 && data.scheduleTimezone.size() <= 60)) &&
        (!('dndActive' in data) || data.dndActive is bool) &&
        (!('dndUntilMs' in data) || (data.dndUntilMs is int && data.dndUntilMs >= 0 && data.dndUntilMs <= 9999999999999)) &&
        (!('dndScheduleEnabled' in data) || data.dndScheduleEnabled is bool) &&
        (!('dndStartTime' in data) || (data.dndStartTime is string && data.dndStartTime.size() == 5 && data.dndStartTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
        (!('dndEndTime' in data) || (data.dndEndTime is string && data.dndEndTime.size() == 5 && data.dndEndTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }

    function isValidCallPlan(data) {
      return data.keys().hasAll(['id', 'name', 'description', 'durationMinutes', 'priceCents', 'currency', 'active', 'sortOrder', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'description', 'durationMinutes', 'priceCents', 'currency', 'active', 'sortOrder', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&
        data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 240 &&
        data.priceCents is int && data.priceCents >= 100 && data.priceCents <= 100000000 &&
        data.currency == 'BRL' &&
        data.active is bool &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCallRequest(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'topic', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'userPhotoUrl', 'topic', 'status', 'planId', 'planName', 'planDurationMinutes', 'planPriceCents', 'paymentStatus', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 160 &&
        data.status in ['waiting', 'accepted', 'in_call', 'ended', 'rejected', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('userPhotoUrl' in data) || (data.userPhotoUrl is string && data.userPhotoUrl.size() <= 500)) &&
        (!('planId' in data) || isValidId(data.planId)) &&
        (!('planName' in data) || (data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 60)) &&
        (!('planDurationMinutes' in data) || (data.planDurationMinutes is int && data.planDurationMinutes >= 1 && data.planDurationMinutes <= 240)) &&
        (!('planPriceCents' in data) || (data.planPriceCents is int && data.planPriceCents >= 100 && data.planPriceCents <= 100000000)) &&
        (!('paymentStatus' in data) || data.paymentStatus in ['authorized', 'captured', 'refunded']);
    }

    function isValidCallMessage(data) {
      return data.keys().hasAll(['id', 'callId', 'senderUid', 'senderName', 'senderRole', 'recipientUid', 'text', 'createdAt']) &&
        data.keys().hasOnly(['id', 'callId', 'senderUid', 'senderName', 'senderRole', 'recipientUid', 'text', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.callId) &&
        isValidId(data.senderUid) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        data.senderRole in ['model', 'moderator', 'viewer'] &&
        isValidId(data.recipientUid) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
        data.createdAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'createdAt']) &&
        isValidId(data.uid) &&
        data.createdAt is timestamp;
    }

    function isValidCallHistory(data) {
      return data.keys().hasAll(['id', 'callId', 'userId', 'userName', 'modelUid', 'durationSeconds', 'amountCents', 'currency', 'status', 'endedAt', 'createdAt']) &&
        data.keys().hasOnly(['id', 'callId', 'userId', 'userName', 'modelUid', 'durationSeconds', 'amountCents', 'currency', 'status', 'planId', 'planName', 'planDurationMinutes', 'rating', 'ratingComment', 'ratedAt', 'endedAt', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.callId) &&
        isValidId(data.userId) &&
        isValidId(data.modelUid) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
        data.amountCents is int && data.amountCents >= 0 && data.amountCents <= 100000000 &&
        data.currency == 'BRL' &&
        data.status in ['completed', 'refunded'] &&
        (!('planId' in data) || (data.planId is string && data.planId.size() <= 128)) &&
        (!('planName' in data) || (data.planName is string && data.planName.size() <= 60)) &&
        (!('planDurationMinutes' in data) || (data.planDurationMinutes is int && data.planDurationMinutes >= 1 && data.planDurationMinutes <= 240)) &&
        (!('rating' in data) || (data.rating is int && data.rating >= 1 && data.rating <= 5)) &&
        (!('ratingComment' in data) || (data.ratingComment is string && data.ratingComment.size() <= 300)) &&
        (!('ratedAt' in data) || data.ratedAt is timestamp) &&
        data.endedAt is timestamp &&
        data.createdAt is timestamp;
    }

    function isValidInterestMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'preferredTime', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'userPhotoUrl', 'preferredTime', 'message', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.preferredTime is string && data.preferredTime.size() >= 1 && data.preferredTime.size() <= 80 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        data.status in ['unread', 'reviewed', 'contacted'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('userPhotoUrl' in data) || (data.userPhotoUrl is string && data.userPhotoUrl.size() <= 500));
    }

    // --- Collection Rules ---

    // 1. Studio Profiles (Public room metadata & access controls; zero PII)
    match /studioProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && (
        isTokenAdmin() ||
        resource.data.uid == request.auth.uid ||
        resource.data.role == 'model'
      );
      allow create: if isSignedIn() && isVerifiedUser() && isValidId(userId) &&
        isValidStudioProfile(incoming()) &&
        userId == request.auth.uid &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isTokenAdmin() && incoming().role == 'model' && incoming().accessStatus == 'vip') ||
          (!isTokenAdmin() && incoming().role == 'viewer' && incoming().accessStatus == 'active')
        );
      allow update: if isSignedIn() && isVerifiedUser() && isValidId(userId) &&
        isValidStudioProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'role', 'accessStatus', 'isOnline', 'notes', 'updatedAt'])
          ) ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().accessStatus == existing().accessStatus &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'isOnline', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 2. Private User Info (Strict PII isolation)
    match /users/{userId}/private/info {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isSignedIn() && isVerifiedUser() && isValidId(userId) &&
        isOwner(userId) &&
        isValidPrivateUserInfo(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().email == request.auth.token.email &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isVerifiedUser() && isValidId(userId) &&
        (isOwner(userId) || isAdmin()) &&
        isValidPrivateUserInfo(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 3. Studio State (Model availability, operating schedule, DND schedule, and active call banner)
    match /studioState/{stateId} {
      allow get: if isSignedIn() && isValidId(stateId) && stateId == 'main';
      allow list: if false;
      allow create: if isAdmin() && isValidId(stateId) && stateId == 'main' &&
        isValidStudioState(incoming()) &&
        incoming().modelUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(stateId) && stateId == 'main' &&
        isValidStudioState(incoming()) &&
        incoming().modelUid == existing().modelUid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['modelName', 'isLive', 'callMode', 'headline', 'activeCallId', 'activeCallUserId', 'activeCallUserName', 'autoScheduleEnabled', 'scheduleStartTime', 'scheduleEndTime', 'scheduleDays', 'scheduleTimezone', 'dndActive', 'dndUntilMs', 'dndScheduleEnabled', 'dndStartTime', 'dndEndTime', 'updatedAt']);
      allow delete: if false;
    }

    // 4. Call Plans (Predefined paid video call plans managed by the model admin)
    match /callPlans/{planId} {
      allow get: if isSignedIn() && isValidId(planId);
      allow list: if isSignedIn() && (
        isTokenAdmin() ||
        resource.data.active == true
      );
      allow create: if isAdmin() && isValidId(planId) &&
        isValidCallPlan(incoming()) &&
        incoming().id == planId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(planId) &&
        isValidCallPlan(incoming()) &&
        incoming().id == existing().id &&
        incoming().currency == existing().currency &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'durationMinutes', 'priceCents', 'active', 'sortOrder', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(planId);
    }

    // 5. Call Queue (Video call requests and lifecycle; requires valid active CallPlan & blocks creation when DND is active)
    match /callQueue/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isTokenAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && isVerifiedUser() && isValidId(requestId) &&
        isValidCallRequest(incoming()) &&
        incoming().id == requestId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'waiting' &&
        'planId' in incoming() &&
        'planName' in incoming() &&
        'planDurationMinutes' in incoming() &&
        'planPriceCents' in incoming() &&
        'paymentStatus' in incoming() &&
        incoming().paymentStatus == 'authorized' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/studioProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/studioProfiles/$(request.auth.uid)).data.accessStatus != 'blocked' &&
        exists(/databases/$(database)/documents/callPlans/$(incoming().planId)) &&
        get(/databases/$(database)/documents/callPlans/$(incoming().planId)).data.active == true &&
        incoming().planName == get(/databases/$(database)/documents/callPlans/$(incoming().planId)).data.name &&
        incoming().planDurationMinutes == get(/databases/$(database)/documents/callPlans/$(incoming().planId)).data.durationMinutes &&
        incoming().planPriceCents == get(/databases/$(database)/documents/callPlans/$(incoming().planId)).data.priceCents &&
        (
          !exists(/databases/$(database)/documents/studioState/main) ||
          (
            (!('dndActive' in get(/databases/$(database)/documents/studioState/main).data) ||
              get(/databases/$(database)/documents/studioState/main).data.dndActive == false) &&
            (!('dndUntilMs' in get(/databases/$(database)/documents/studioState/main).data) ||
              get(/databases/$(database)/documents/studioState/main).data.dndUntilMs <= request.time.toMillis())
          )
        );
      allow update: if isSignedIn() && isVerifiedUser() && isValidId(requestId) &&
        isValidCallRequest(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (!('planId' in existing()) || incoming().planId == existing().planId) &&
        (!('planName' in existing()) || incoming().planName == existing().planName) &&
        (!('planDurationMinutes' in existing()) || incoming().planDurationMinutes == existing().planDurationMinutes) &&
        (!('planPriceCents' in existing()) || incoming().planPriceCents == existing().planPriceCents) &&
        (!(existing().status in ['ended', 'rejected', 'cancelled']) || isAdmin()) &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])
          ) ||
          (
            existing().userId == request.auth.uid &&
            (
              (existing().status == 'waiting' && incoming().status == 'cancelled') ||
              (existing().status == 'waiting' && incoming().status == 'in_call') ||
              (existing().status == 'accepted' && incoming().status == 'in_call') ||
              (existing().status == 'in_call' && incoming().status == 'ended')
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(requestId);
    }

    // 6. Call Messages (In-call 1-on-1 & shared group room chat messages)
    match /callMessages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (
        isAdmin() ||
        resource.data.recipientUid == 'main_studio_room' ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isTokenAdmin() ||
        resource.data.recipientUid == 'main_studio_room' ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
      allow create: if isSignedIn() && isVerifiedUser() && isValidId(messageId) &&
        isValidCallMessage(incoming()) &&
        incoming().id == messageId &&
        incoming().senderUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        (
          (incoming().callId == 'main_studio_room' && incoming().recipientUid == 'main_studio_room') ||
          exists(/databases/$(database)/documents/callQueue/$(incoming().callId))
        ) &&
        exists(/databases/$(database)/documents/studioProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/studioProfiles/$(request.auth.uid)).data.accessStatus != 'muted' &&
        get(/databases/$(database)/documents/studioProfiles/$(request.auth.uid)).data.accessStatus != 'blocked';
      allow update: if false;
      allow delete: if isAdmin() && isValidId(messageId);
    }

    // 7. Admins Registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if false;
      allow create: if isTokenAdmin() && isValidId(adminId) &&
        adminId == request.auth.uid &&
        isValidAdminUser(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 8. Call History, Finalized Transactions, and Post-Session Quality Ratings
    match /callHistory/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isTokenAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAdmin() && isValidId(recordId) &&
        isValidCallHistory(incoming()) &&
        incoming().id == recordId &&
        incoming().modelUid == request.auth.uid &&
        !('rating' in incoming()) &&
        !('ratingComment' in incoming()) &&
        !('ratedAt' in incoming()) &&
        incoming().endedAt == request.time &&
        incoming().createdAt == request.time;
      allow update: if isSignedIn() && isVerifiedUser() && isValidId(recordId) &&
        isValidCallHistory(incoming()) &&
        incoming().id == existing().id &&
        incoming().callId == existing().callId &&
        incoming().userId == existing().userId &&
        incoming().userName == existing().userName &&
        incoming().modelUid == existing().modelUid &&
        incoming().durationSeconds == existing().durationSeconds &&
        incoming().amountCents == existing().amountCents &&
        incoming().currency == existing().currency &&
        incoming().endedAt == existing().endedAt &&
        incoming().createdAt == existing().createdAt &&
        (!('planId' in existing()) ? !('planId' in incoming()) : ('planId' in incoming() && incoming().planId == existing().planId)) &&
        (!('planName' in existing()) ? !('planName' in incoming()) : ('planName' in incoming() && incoming().planName == existing().planName)) &&
        (!('planDurationMinutes' in existing()) ? !('planDurationMinutes' in incoming()) : ('planDurationMinutes' in incoming() && incoming().planDurationMinutes == existing().planDurationMinutes)) &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
            (!('rating' in existing()) ? !('rating' in incoming()) : ('rating' in incoming() && incoming().rating == existing().rating)) &&
            (!('ratingComment' in existing()) ? !('ratingComment' in incoming()) : ('ratingComment' in incoming() && incoming().ratingComment == existing().ratingComment)) &&
            (!('ratedAt' in existing()) ? !('ratedAt' in incoming()) : ('ratedAt' in incoming() && incoming().ratedAt == existing().ratedAt))
          ) ||
          (
            existing().userId == request.auth.uid &&
            !('rating' in existing()) &&
            incoming().status == existing().status &&
            'rating' in incoming() &&
            'ratedAt' in incoming() &&
            incoming().ratedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'ratingComment', 'ratedAt'])
          )
        );
      allow delete: if false;
    }

    // 9. Offline Interest Messages (Visitor messages left while model is resting/offline)
    match /interestMessages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isTokenAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && isVerifiedUser() && isValidId(messageId) &&
        isValidInterestMessage(incoming()) &&
        incoming().id == messageId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'unread' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/studioProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/studioProfiles/$(request.auth.uid)).data.accessStatus != 'blocked';
      allow update: if isAdmin() && isValidId(messageId) &&
        isValidInterestMessage(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().userName == existing().userName &&
        incoming().preferredTime == existing().preferredTime &&
        incoming().message == existing().message &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(messageId);
    }
  }
}
